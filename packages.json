{
  "schema": "swi.online.test.rebuild.packages.v3",
  "project": "SWI Online Test Rebuild + Component Registry",
  "mode": "TEST_ONLY",
  "repositories": {
    "v1": {
      "url": "https://github.com/Kelronmos/SWI-V1-Module-1-10.git",
      "branch": "main",
      "role": "ACTIVE_CORE_V1",
      "required_for": ["v1_tests", "node_access_boundary_tests"],
      "toolchain": ["git", "python>=3.10"],
      "dependency_file": "requirements.txt",
      "rebuild": "python -m venv .venv; pip install -r requirements.txt",
      "test": "python -m pytest -q",
      "verify": "scripts/verify.sh"
    },
    "v2": {
      "url": "https://github.com/Kelronmos/SWI-V2-Modules-11-22.git",
      "branch": "main",
      "role": "ACTIVE_CORE_V2",
      "required_for": ["v2_tests"],
      "toolchain": ["git", "python>=3.10"],
      "dependency_file": "requirements.txt",
      "rebuild": "tools/rebuild_swi.sh or tools/rebuild_swi.bat",
      "test": "python -m pytest -q"
    },
    "node_access_boundary": {
      "url": "https://github.com/Kelronmos/SWI-Node-Access-Boundary.git",
      "branch": "main",
      "role": "RELATED_TEST_PACKAGE",
      "required_for": ["distributed_node_boundary_tests"],
      "depends_on": ["v1"],
      "toolchain": ["git", "python>=3.10"],
      "build": "python -m pytest --collect-only -q",
      "test": "python -m pytest test/test_access_boundary.py -v"
    },
    "mathematical_evidence_engine": {
      "url": "https://github.com/Kelronmos/SWI-Mathematical-Evidence-Engine.git",
      "branch": "main",
      "role": "RELATED_EVIDENCE_ENGINE",
      "required_for": ["mathematical_evidence_engine_tests"],
      "toolchain": ["git", "node>=18"],
      "dependency_file": "package.json",
      "build": "npm install; npm run build",
      "test": "npm run lint"
    },
    "firefly_memory": {
      "url": "https://github.com/Kelronmos/swi-firefly-memory.git",
      "branch": "main",
      "role": "RELATED_MEMORY_ENGINE",
      "required_for": ["firefly_memory_tests", "firefly_memory_simulation"],
      "toolchain": ["git", "node>=18"],
      "dependency_file": "package.json",
      "build": "npm install; npm run build",
      "test": "npm run lint",
      "status": "DEVELOPMENT_SUSPENDED"
    },
    "structured_workflow_intelligence": {
      "url": "https://github.com/Kelronmos/Structured-Workflow-Intelligence.git",
      "branch": "main",
      "role": "LEGACY_RELATED_PLATFORM",
      "required_for": [],
      "toolchain": ["git", "node>=18"],
      "dependency_file": "package.json",
      "build": "npm install; npm run build",
      "test": "npm run test",
      "verify": "npm run verify"
    },
    "rust_governance_engine": {
      "url": "https://github.com/Kelronmos/structured-workflow-intelligence-rust.git",
      "branch": "main",
      "role": "RELATED_RUST_PROTOTYPE",
      "required_for": [],
      "toolchain": ["git", "rust>=1.70", "cargo"],
      "dependency_file": "Cargo.toml",
      "build": "cargo build --release",
      "test": "cargo test"
    },
    "v103_api_foundation": {
      "url": "https://github.com/Kelronmos/SWI_V103_API_Foundation.git",
      "branch": "main",
      "role": "LEGACY_API_STUB",
      "required_for": [],
      "toolchain": ["git"],
      "build": "NO_BUILD_CLAIM",
      "test": "NO_TEST_CLAIM",
      "status": "LEGACY_STUB"
    }
  },
  "components": [
    {
      "id": "common_sense",
      "display_name": "Common Sense",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "Path not established from filesystem evidence; do not infer from docs alone."
    },
    {
      "id": "reflex_sadu",
      "display_name": "REFLEX / SADU",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "Account separately for REFLEX and SADU if distinct implementations exist."
    },
    {
      "id": "cek",
      "display_name": "CEK",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "invariants": [
        "OBSERVATION ≠ AUTHORITY",
        "UNKNOWN ≠ PERMITTED",
        "STABLE ≠ AUTHORIZED"
      ]
    },
    {
      "id": "scar",
      "display_name": "SCAR",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v1", "path": null},
      "notes": "Inventory and test only if implementation exists."
    },
    {
      "id": "seeder",
      "display_name": "SEEDER",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "Do not treat generated fixtures as production nodes."
    },
    {
      "id": "s9_security_maze",
      "display_name": "S9 Security Maze",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "S9 output is not automatic truth; requires memory validation and replay."
    },
    {
      "id": "zero_trust_task_travel",
      "display_name": "Zero-Trust Task Travel",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "Document ≠ implementation. Track DESIGN / IMPLEMENTED / TESTED / PROVEN / SEALED separately."
    },
    {
      "id": "structured_seal",
      "display_name": "Structured Seal",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "HASH ≠ STRUCTURED SEAL"
    },
    {
      "id": "runtime_seal",
      "display_name": "Runtime Seal",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "STRUCTURED SEAL ≠ RUNTIME SEAL ≠ PRODUCTION AUTHORIZATION"
    },
    {
      "id": "mathematical_geometric_zero",
      "display_name": "Mathematical / Geometric Zero",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "notes": "FAIL_CLOSED_BASELINE ≠ TRUE_ZERO. Do not reconstruct missing historical evidence."
    },
    {
      "id": "evidence_engine",
      "display_name": "Evidence Engine",
      "type": "component",
      "source": {"kind": "repository", "repository": "mathematical_evidence_engine", "path": null},
      "notes": "EVIDENCE ENGINE ≠ AUTHORIZATION ENGINE"
    },
    {
      "id": "firefly_memory",
      "display_name": "Firefly Memory",
      "type": "component",
      "source": {"kind": "repository", "repository": "firefly_memory", "path": null},
      "status_hint": "DEVELOPMENT_SUSPENDED"
    },
    {
      "id": "node_access_boundary",
      "display_name": "Node Access Boundary",
      "type": "component",
      "source": {"kind": "repository", "repository": "node_access_boundary", "path": null}
    },
    {
      "id": "consequence_authorization_gate",
      "display_name": "Consequence / Authorization Gate",
      "type": "component",
      "source": {"kind": "repository_path", "repository": "v2", "path": null},
      "invariants": [
        "CONSEQUENCE ≠ AUTHORIZATION",
        "AUTHORIZATION ≠ ACTION"
      ],
      "notes": "All tests must remain synthetic. No real-world side effects."
    }
  ],
  "runtime": {
    "language": "python",
    "minimum": "3.10",
    "recommended": "3.12",
    "virtual_environment": ".venv"
  },
  "toolchains": {
    "python": ">=3.10",
    "node": ">=18",
    "rust": ">=1.70",
    "git": "required"
  },
  "workspace": {
    "root": "swi-test-workspace",
    "v1": "swi-test-workspace/v1",
    "v2": "swi-test-workspace/v2",
    "repositories": "swi-test-workspace/repos",
    "artifacts": "swi-test-workspace/artifacts",
    "reports": "swi-test-workspace/reports",
    "logs": "swi-test-workspace/logs",
    "downloads": "swi-test-workspace/downloads"
  },
  "online_sync": {
    "enabled": true,
    "method": "git",
    "strategy": "ff-only",
    "remote": "origin",
    "destructive_commands_forbidden": true,
    "fresh_clone_preferred": true,
    "dirty_checkout_action": "STOP_AND_REPORT"
  },
  "execution_policy": {
    "missing_toolchain": "RECORD_NOT_RUN",
    "dependency_failure": "RECORD_FAILURE",
    "build_failure": "RECORD_FAILURE",
    "test_failure": "RECORD_FAILURE",
    "missing_source": "RECORD_MISSING",
    "no_result_promotion": true,
    "v1_runtime_imported_into_v2": false,
    "simulation_is_not_proof": true,
    "production_authorization": false
  },
  "test_matrix": {
    "smoke": 10,
    "standard": 100,
    "extended": 1000,
    "full": 8000,
    "deterministic_seed": 20261004,
    "deterministic_seed_required": true
  },
  "reporting": {
    "json": true,
    "pdf": true,
    "html": true,
    "sha256_manifest": true,
    "outputs": [
      "FINAL_STATUS.txt",
      "final_report.json",
      "final_report.html",
      "sha256_manifest.json",
      "inventory.json",
      "component_status.json",
      "BUILD_RESULTS.json",
      "TEST_RESULTS.json",
      "FIREFLY_RESULTS.json",
      "simulation_results.json"
    ]
  },
  "claims": {
    "rebuild": "IMPLEMENTED",
    "system_completion": "INCOMPLETE",
    "proven": false,
    "sealed": false,
    "production_authorized": false
  }
}
